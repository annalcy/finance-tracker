# Copy this file to .env.local for local testing (never commit .env.local)

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Paste the entire service account JSON as a single line (minified)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# iCloud calendar sync (CalDAV, read-only — Personal OS displays these events
# but never creates/edits/deletes anything on iCloud). Generate an
# app-specific password at appleid.apple.com (Security > App-Specific
# Passwords). Never use the real Apple ID password here, Apple's CalDAV
# server rejects it. Pulls from every calendar that supports events
# (Home/Work/Family/etc.) merged together — no per-calendar config needed.
ICLOUD_APPLE_ID=your_apple_id_email@example.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
